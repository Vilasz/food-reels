# Database
# For Vercel deployment, use a connection pooler URL
# Example with Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/database?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/foodreels?schema=public"

# Optional: Direct database URL (for migrations)
# DIRECT_URL="postgresql://user:password@localhost:5432/foodreels?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# For production (Vercel):
# NEXTAUTH_URL="https://your-domain.vercel.app"

